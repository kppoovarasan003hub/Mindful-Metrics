# ==============================================================================
# MindfulMetrics — .gitignore
# ==============================================================================

# Python bytecode and cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments & secrets
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Test, coverage, and tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Runtime and application logs
*.log

# Editors & Operating System
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Generated dataset and model artefacts
# Rebuild with:
#   python -m training.make_dataset
#   python -m training.train_model
data/*
!data/.gitkeep
models/*
!models/.gitkeep